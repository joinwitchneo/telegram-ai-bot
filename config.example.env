# Telegram 机器人配置（请勿提交到公开仓库）
# 1) 在 Telegram 里找 @BotFather，发送 /newbot 创建机器人，获得 token
# 2) 把 token 填到下面 TELEGRAM_BOT_TOKEN= 后面（保留格式：TOKEN=123456:ABC...）
TELEGRAM_BOT_TOKEN=

# 后端选择：deepseek（云端 API）或 ollama（本地模型）
BACKEND=deepseek

# DeepSeek API（在 https://platform.deepseek.com 创建 API Key）
# 注意：deepseek-chat / deepseek-reasoner 旧模型名已于 2026-07-24 停用
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# 本地 Ollama（把 BACKEND 改为 ollama 时使用）
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.6

# 系统提示词（可自定义机器人人设）
SYSTEM_PROMPT=你是一个友好、乐于助人的中文AI助手。回答要自然、简洁、准确；不确定时直接说明。

# 主动消息（饭点问候 + 短事件主动聊天 + 闲置查岗；false 可整体关闭）
PROACTIVE_ENABLED=true
# 发给哪个会话（一般是你的私人聊天 id；留空会自动从历史记录里取）
PROACTIVE_CHAT_ID=
# 随机问候已取消：只保留饭点问候（MEAL_* 三个窗口）；此项保留兼容、不再生效
PROACTIVE_COUNT=4
PROACTIVE_WINDOW=08:00-23:30
# 也可以指定固定时间表（填了就用固定的，留空则用上面的随机时间点）
PROACTIVE_TIMES=
# 饭点询问：问吃早饭/午饭/晚饭只在饭点发（北京时间，与你的时区一致）；
# 每个窗口内随机一个时间点，窗口过了不补发（避免晚饭时间问午饭）
MEAL_ENABLED=true
MEAL_BREAKFAST=07:00-08:00
MEAL_LUNCH=11:30-12:30
MEAL_DINNER=18:00-19:00
# 闲置多少小时后主动发一条撒娇"查岗"消息（每天最多一次）
PROACTIVE_IDLE_HOURS=6
# 问候时间随机偏移（分钟），避免太机械
PROACTIVE_JITTER_MINUTES=15
# 随机"特别事件"（约每周一次，角色主动分享趣事/囧事/小插曲）
PROACTIVE_EVENT_DAYS=7

# 表情包：回复时按文本情绪随机补一张（0~1，0.35 表示约 1/3 的消息带表情）
STICKER_SEND_PROB=0.35

# 节日/生日短消息：到日子发一条真心话式的短消息（V2 起不再写长故事）
# 下面三项是历史兼容配置，保留但已不生效
EVENT_MIN_CHARS=600
EVENT_MAX_CHARS=800
EVENT_MAX_TOKENS=2000
# 互动频率：日常话题每隔几天主动开口一次（默认每 2 天左右一次，每天最多一次）
CHAR_EVENT_DAYS=5
# 主动短聊的间隔
SHORT_EVENT_DAYS=2
# 沉默跟进：10 分钟没回先傲娇问一句"在忙吗"，15 分钟没回再发结束聊天的人设语句
ASK_BUSY_AFTER_MINUTES=10
LEAVE_AFTER_MINUTES=15
# 沉默跟进触发概率（0~1）：默认 25%，每个阶段各掷一次骰子，不是每次都发
IDLE_FOLLOWUP_PROB=0.25
# 主动消息（饭点问候/短事件/长事件/结束聊天等）只在每天 07:00-22:00（北京时间）之间发
PROACTIVE_ACTIVE_WINDOW=07:00-22:00

# 对方提到自己的近况时，随机触发"关心/吐槽"的概率（0~1）
CARE_BANTER_PROB=0.2
# 主动长事件（节日/生日/日常）避开聊天的时间窗口（分钟）：最近 90 分钟内聊过就暂时不发，优先聊天
EVENT_ACTIVE_WINDOW=90

# 第二本世界书（角色记忆）：每 N 轮对话自动总结一次聊天内容
MEMORY_SUMMARY_EVERY=6
# 每次注入给模型的记忆最多多少字符（控制 token 消耗）
MEMORY_INJECT_LIMIT=2500
# 记忆条目超过多少条时自动整理合并（旧记忆压进"长期记忆"）
MEMORY_CONDENSE_AT=25

# 聊天回复长度风格：short=短对话(≤15字) medium=中对话(~75字) normal=默认(2~4条) mixed=随机混合
REPLY_STYLE=mixed

# 晨间简报：跟早上第一条问候一起附带天气 + 一条要闻
BRIEFING_ENABLED=true
# 天气城市（wttr.in，免费）
CITY=香港

# 联网搜索：Tavily（https://app.tavily.com 免费注册拿 Key）
SEARCH_API_KEY=
SEARCH_API_URL=https://api.tavily.com/search

# 提醒存储文件（相对 telegram-bot 目录）
REMINDERS_FILE=reminders.json

# 备忘录存储文件
MEMOS_FILE=memos.json

# 本地代理（如果代理跑在本机就填，比如 http://127.0.0.1:7890；走路由器代理或不需要就留空）
HTTPS_PROXY=

# ===== 发消息的节奏（真人感）=====
# 连发合并窗口：你连着发几条，等最后一条之后这么久再一起回（单条消息等一半时间）
REPLY_DEBOUNCE_SECONDS=3.0
# 回复速度三档权重：秒回,正常,慢回（20,60,20 表示 20%/60%/20%）
REPLY_SPEED_TIERS=20,60,20
# 慢回档的等待区间（秒）
REPLY_SLOW_RANGE=10-25
# 打字速度（字/秒，区间），用来估算每条消息要"打"多久
TYPING_CPS=2.5-4.5
# "正在输入"状态的刷新间隔（秒，Telegram 状态 5 秒过期）
TYPING_REFRESH=4.0
# 一次回复最多发几条消息（超出会合并）
MAX_MESSAGES_PER_REPLY=6
# 先发一句缓冲话（"等下""我看看"）的概率
FILLER_PROB=0.25
# 深夜（默认 0-7 点）额外多等的秒数区间
LATE_NIGHT_DELAY=3-10
LATE_NIGHT_WINDOW=0-7

# ===== 主动开口 =====
# 每日清单汇总时间（没有待办就不发）
DAILY_SUMMARY_MORNING=08:30
DAILY_SUMMARY_NIGHT=22:00
# AI 牢骚：每周最多几次（0 = 关闭）
RANT_PER_WEEK=3
# 深夜关心的时间窗口（跨零点写法）
LATE_CARE_WINDOW=23:30-01:00

# ===== 记忆书（第二本世界书）=====
# 每隔多少分钟检查一次记忆书
MEMORY_CHECK_MINUTES=60
# 同一个会话最短多久真正整理一次（小时）
MEMORY_MIN_INTERVAL_HOURS=6
# 记忆总字数超过这个值就整体重写压缩
MEMORY_REBUILD_AT=8000

# ===== V2 状态系统（夕颜）=====
# 情绪/关系/回复短语的存储文件
STATES_FILE=states.json
# 每几轮做一次"结构化记忆抽取"（挑出值得长期记住的事实与偏好）
MEMORY_EXTRACT_EVERY=3
# 主动消息冷却时间（分钟）：刚发过就安静一会儿，避免变成骚扰
PROACTIVE_COOLDOWN_MINUTES=45
