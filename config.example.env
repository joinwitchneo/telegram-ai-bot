# ===== 基础 =====
TELEGRAM_BOT_TOKEN=
BACKEND=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
OLLAMA_URL=http://127.0.0.1:11434

# ===== 模型（全部配置化，代码里不硬编码任何模型名）=====
# 聊天用主模型；摘要/抽取用便宜模型；强模型留空 = 不启用
CHAT_MODEL=deepseek-v4-flash
SUMMARY_MODEL=deepseek-flash
EXTRACTION_MODEL=deepseek-flash
STRONG_MODEL=
# 某个档位模型不可用时的降级顺序
MODEL_FALLBACK_ORDER=strong,main,cheap

# ===== Token 预算 =====
MAX_CONTEXT_TOKENS=6000
MAX_OUTPUT_TOKENS=400
DAILY_TOKEN_BUDGET=300000
BUDGET_SOFT_RATIO=0.8
BUDGET_HARD_RATIO=0.95

# ===== 消息节奏 =====
# 连发合并窗口：单条等 1 秒，第二条起等 2 秒
DEBOUNCE_SINGLE_SECONDS=1.0
DEBOUNCE_MULTI_SECONDS=2.0
# 每轮带多少条历史（Phase 2 起按对话模式动态调整）
HISTORY_MESSAGES=12
# 四种对话模式各自的历史窗口（条数是默认值，仍受 MAX_CONTEXT_TOKENS 限制）
HISTORY_CASUAL=12
HISTORY_DEEP=25
HISTORY_EMOTIONAL=25
HISTORY_TASK=12
# Python 对 MessagePlan 的硬约束
MESSAGE_MAX_COUNT=4
MESSAGE_MIN_PAUSE=0.5
MESSAGE_MAX_PAUSE=8.0
MESSAGE_MAX_CHARS=800
TYPING_CPS=2.5-4.5
STICKER_SEND_PROB=0.35
STICKER_MAX_PROBABILITY=0.35

# ===== 日志与调试 =====
# Token 只写日志与 data/usage.json，不在 Telegram 里暴露
USAGE_LOG_ENABLED=true
CONTEXT_DEBUG=false
CONTEXT_SNAPSHOT=false

# ===== 其它 =====
PROACTIVE_CHAT_ID=
CITY=香港
SEARCH_API_KEY=
SEARCH_API_URL=https://api.tavily.com/search
REMINDERS_FILE=reminders.json
MEMOS_FILE=memos.json
STATES_FILE=states.json
MEMORIES_FILE=memories.json
USAGE_FILE=usage.json
# 本机代理（走路由器代理时留空）
HTTPS_PROXY=

# ===== 以下键供 Phase 2-7 使用，本阶段只声明不实现 =====
MEMORY_WEIGHT_KEYWORD=0.45
MEMORY_WEIGHT_IMPORTANCE=0.25
MEMORY_WEIGHT_RECENCY=0.15
MEMORY_WEIGHT_FREQUENCY=0.10
MEMORY_WEIGHT_EMOTION=0.05
MEMORY_TOPK=5
MEMORY_TOP_K=5
MEMORY_DEDUP_SIMILARITY=0.55
MEMORY_COLD_KEYWORD_MIN=0.3
MEMORY_EXTRACT_ENABLED=true
MEMORY_SUMMARY_MIN_MESSAGES=30
MEMORY_SUMMARY_MAX_MESSAGES=50
MEMORY_SUMMARY_TOKEN_THRESHOLD=1500
TOPICS_FILE=topics.json
TOPIC_COOLDOWN_DAYS=3
TOPIC_DORMANT_DAYS=14
# ===== Phase 4：情绪 / 关系（0 token，纯事件驱动）=====
EMOTION_STATE_FILE=emotion_state.json
RELATIONSHIP_STATE_FILE=relationship_state.json
# 惯性：越大情绪越"稳"，单条消息改变越小
EMOTION_INERTIA=0.6
RELATIONSHIP_INERTIA=0.35
# 可选：覆盖单维度衰减率，格式 name:rate,name:rate
EMOTION_DECAY_OVERRIDES=
RELATIONSHIP_DECAY_OVERRIDES=
# 只有变化幅度超过这个值、且过了冷却时间，才会写 emotion_event / relationship_event
STATE_EVENT_MEMORY_DELTA=0.15
STATE_EVENT_MEMORY_COOLDOWN_MINUTES=360
MEMORY_HOT_DAYS=3
MEMORY_WARM_DAYS=30
MEMORY_ARCHIVE_DAYS=90
# 主动消息的阈值/上限统一放在下面的 Phase 6 段落里，这里不再重复声明
RESPONSE_SCORE_NORMAL=0.6
RESPONSE_SCORE_SHORT=0.35
REPLY_MAX_RETRY=1

# ===== Phase 5：回复计划 / 用户风格 / AI 味（全部 0 token）=====
PLANNER_SCORE_NORMAL=0.75
PLANNER_SCORE_SHORT=0.50
PLANNER_SCORE_LOW=0.30
# 低价值消息可以"不回"，但必须有原因：不能在第一条消息、不能连续两次、有冷却
PLANNER_ALLOW_SILENCE=true
PLANNER_SILENCE_COOLDOWN_MINUTES=10
PLANNER_MAX_CONSECUTIVE=3
STYLE_FILE=user_style.json
STYLE_EMA_ALPHA=0.10
STYLE_EMA_ALPHA_SLOW=0.03
STYLE_MIN_MESSAGES=5
STYLE_COMMON_WORDS=12
RESPONSE_STATS_FILE=response_stats.json
AI_FLAVOR_ENABLED=true
AI_FLAVOR_MAX_SEVERITY=0.5
STICKER_ENABLED=true
# 单条消息长度按回复长度档限制
MESSAGE_MAX_CHARS_ULTRA_SHORT=30
MESSAGE_MAX_CHARS_SHORT=60
MESSAGE_MAX_CHARS_NORMAL=200
MESSAGE_MAX_CHARS_LONG=800
# 模型失败/超时时的兜底话术（用 | 分隔多条，轮流用）
FALLBACK_REPLY_TEXTS=等下，我刚刚有点卡。|嗯…我这边抽了一下，你刚说什么？

# ===== Phase 6：Character Life + 主动消息 =====
PROACTIVE_ENABLED=true
PROACTIVE_QUIET_START=23:30
PROACTIVE_QUIET_END=08:00
# 每天最多几次（硬上限，不是必须发满）
PROACTIVE_DAILY_LIMIT=3
PROACTIVE_MIN_INTERVAL_MINUTES=90
# 用户刚聊完多久之内不主动打扰
PROACTIVE_RECENT_CHAT_MINUTES=45
# 主动后多久没回算一次"没回"；连续两次 → 冷却
PROACTIVE_NONRESPONSE_HOURS=3
PROACTIVE_NONRESPONSE_LIMIT=2
PROACTIVE_COOLDOWN_HOURS=6
# 分数阈值：>=FULL 正常主动，>=SHORT 轻主动，低于 SHORT 不主动
PROACTIVE_THRESHOLD_FULL=0.75
PROACTIVE_THRESHOLD_SHORT=0.35
# 特殊事件（生日、明确说过的考试/约定）可以越过阈值和冷却，但仍受每日上限与静默时段限制
PROACTIVE_SPECIAL_OVERRIDE=true
PROACTIVE_TOPIC_COOLDOWN_HOURS=72
PROACTIVE_MEMORY_MIN_AGE_HOURS=2
PROACTIVE_GAP_FULL_HOURS=48
PROACTIVE_TICK_MINUTES=15
CHARACTER_LIFE_FILE=character_life.json
CHARACTER_LIFE_MAX_ENTRIES=80
PROACTIVE_STATE_FILE=proactive_state.json
PROACTIVE_HISTORY_FILE=proactive_history.json

# ===== Phase 7：Tool Layer（本地优先，联网其次，付费最后）=====
TOOL_LAYER_ENABLED=true
# 单个工具的超时（秒）；超时只影响这个工具，不影响聊天
TOOL_HTTP_TIMEOUT=12
TOOL_CACHE_ENABLED=true
TOOL_CACHE_FILE=tool_cache.json
TOOL_COST_FILE=tool_cost.json
# 权限：联网工具 / 本地模型 / 付费接口，各自可单独关掉
ALLOW_NETWORK_TOOLS=true
ALLOW_LOCAL_MODEL=true
ALLOW_PAID_TOOLS=true
# 本地视觉（Ollama）；留空 = 自动挑选本机已装的视觉模型
VISION_ENABLED=true
VISION_MODEL=
VISION_PROMPT=
# 开机后 Ollama 常常不在，让机器人自己把它拉起来（填 ollama.exe 的完整路径）
OLLAMA_EXE=
OLLAMA_AUTOSTART=true
OLLAMA_START_TIMEOUT=90
# 是否在启动时预热本地视觉（默认 false：按需启动）
PERCEPTION_WARMUP=false
# 开机后等网络/代理就绪再开始轮询（秒）
STARTUP_NETWORK_WAIT_SECONDS=180
# OCR 与语音（都用本机能力，不上云）
OCR_ENABLED=true
WHISPER_MODEL_PATH=
WHISPER_LANGUAGE=zh
VIDEO_MAX_FRAMES=4
# 语音回复默认关闭：本机没装 TTS 时打开也没用
VOICE_REPLY_ENABLED=false
TTS_PIPER_MODEL=
# 表情包与临时媒体目录
STICKER_FILE=stickers.json
MEDIA_TMP_DIR=tmp
# 便携版二进制目录（没有管理员权限时，ffmpeg / whisper.cpp / ollama 都放这里）
TOOL_BIN_DIR=
WHISPER_MODEL_PATH=
# 给 whisper 一点上下文提示，避免把"夕颜"听成同音字
WHISPER_PROMPT=
