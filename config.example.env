# ===== Telegram 机器人配置（示例模板） =====
# 使用方法：把本文件复制为 config.env 并填写；或在部署平台的环境变量里配置同名项。
# 注意：config.env 含密钥，已被 .gitignore 忽略，请勿提交到公开仓库。

# 1) 在 Telegram 里找 @BotFather，发送 /newbot 创建机器人，获得 token
# 2) 把 token 填到下面（格式：123456:ABC...）
TELEGRAM_BOT_TOKEN=

# 后端选择：deepseek（云端 API）或 ollama（本地模型）
BACKEND=deepseek

# DeepSeek API（在 https://platform.deepseek.com 创建 API Key）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# 本地 Ollama（把 BACKEND 改为 ollama 时使用）
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3

# 系统提示词（可选；若存在 persona.txt 会优先使用 persona.txt）
SYSTEM_PROMPT=你是一个友好、乐于助人的中文AI助手。回答要自然、简洁、准确；不确定时直接说明。

# ===== 主动消息 =====
# 主动消息总开关
PROACTIVE_ENABLED=true
# 发给哪个会话（一般是你的私聊 id；留空会自动从历史记录里取）
PROACTIVE_CHAT_ID=
# 随机问候已取消：只保留饭点问候（MEAL_* 三个窗口）；此项保留兼容、不再生效
PROACTIVE_COUNT=4
PROACTIVE_WINDOW=08:00-23:30
# 也可以指定固定时间表（填了就用固定的，留空则用上面的随机时间点）
PROACTIVE_TIMES=
# 饭点询问：问吃早饭/午饭/晚饭只在饭点发（北京时间；与你的时区一致）
# 每个窗口内随机一个时间点，窗口过了不补发（避免晚饭时间问午饭）
MEAL_ENABLED=true
MEAL_BREAKFAST=07:00-08:00
MEAL_LUNCH=11:30-12:30
MEAL_DINNER=18:00-19:00
# 问候时间随机偏移（分钟），避免太机械
PROACTIVE_JITTER_MINUTES=15
# 随机"特别事件"（约每周一次，分享趣事/囧事/小插曲）
PROACTIVE_EVENT_DAYS=7

# 表情包：回复时按文本情绪随机补一张（0~1，0.35 表示约 1/3 的消息带表情）
# 表情包文件见 stickers.json
STICKER_SEND_PROB=0.35

# 节日/生日长事件：到日子先发短祝福，再整段生成一篇长故事
# 目标字数 600~800 中文字符；EVENT_MAX_TOKENS 是单次生成的上限
EVENT_MIN_CHARS=600
EVENT_MAX_CHARS=800
EVENT_MAX_TOKENS=2000
# 日常长事件：每月 5~6 次（默认每 5 天一次），先短铺垫、再讲一整篇长故事
CHAR_EVENT_DAYS=5
# 日常短事件：每月 10~15 次（默认每 2 天左右一次，每天最多一次），主动找对方短聊
SHORT_EVENT_DAYS=2
# 沉默跟进：10 分钟没回先问一句"在忙吗"，15 分钟没回再发结束聊天
ASK_BUSY_AFTER_MINUTES=10
LEAVE_AFTER_MINUTES=15
# 沉默跟进触发概率（0~1）：默认 25%，每个阶段各掷一次骰子，不是每次都发
IDLE_FOLLOWUP_PROB=0.25
# 主动消息只在每天 07:00-22:00（北京时间）之间发
PROACTIVE_ACTIVE_WINDOW=07:00-22:00

# 对方提到自己的近况时，随机触发"关心/拌嘴"的概率（0~1）
CARE_BANTER_PROB=0.2
# 主动长事件避开聊天的时间窗口（分钟）：最近 90 分钟内聊过就暂时不发，优先聊天
EVENT_ACTIVE_WINDOW=90

# 第二本世界书（角色记忆）：每 N 轮对话自动总结一次聊天内容
MEMORY_SUMMARY_EVERY=6
# 每次注入给模型的记忆最多多少字符（控制 token 消耗）
MEMORY_INJECT_LIMIT=2500
# 记忆条目超过多少条时自动整理合并（旧记忆压进"长期记忆"）
MEMORY_CONDENSE_AT=25

# 聊天回复长度风格：short=短对话(≤15字) medium=中对话(~75字) normal=默认(2~4条) mixed=随机混合
REPLY_STYLE=mixed

# 晨间简报：跟早上第一条问候一起附带天气
BRIEFING_ENABLED=true
# 天气城市（wttr.in，免费）
CITY=香港

# 联网搜索：Tavily（https://app.tavily.com 免费注册拿 Key）
SEARCH_API_KEY=
SEARCH_API_URL=https://api.tavily.com/search

# 提醒存储文件
REMINDERS_FILE=reminders.json
